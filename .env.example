# Copy to .env (never commit .env). The frontend never sees these values.

# Jev (~typesafe/jev-latest) and every LLM go through OpenRouter.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api

# Public market-data mirror, not geo-blocked. Use https://api.binance.com if you prefer.
# BINANCE_BASE_URL=https://data-api.binance.vision

# HTTP_TIMEOUT_S=60
# HTTP_MAX_RETRIES=3

# Per-agent keys: set "api_key_env" in an agent config to the name of another variable here,
# e.g. LAYA_API_KEY for a protected laya-serve.
